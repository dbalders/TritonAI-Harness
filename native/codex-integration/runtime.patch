+//! A process-wide ceiling installed by a dedicated host before starting any session.
+
+use std::sync::OnceLock;
+
+use codex_extension_api::ToolName;
+use codex_extension_api::ToolPolicy;
+use serde::Deserialize;
+
+static POLICY: OnceLock<IntegrationOnlyPolicy> = OnceLock::new();
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct IntegrationOnlyPolicy {
+    pub protocol: String,
+    pub tools: Vec<String>,
+}
+
+pub fn install(policy: IntegrationOnlyPolicy) -> Result<(), &'static str> {
+    if policy.protocol != "tritonai.codex-integration-only/v1"
+        || policy.tools.len() > 512
+        || policy.tools.iter().any(|name| {
+            name.is_empty()
+                || name.len() > 128
+                || !name.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'_')
+        })
+        || policy.tools.iter().collect::<std::collections::HashSet<_>>().len()
+            != policy.tools.len()
+    {
+        return Err("invalid integration-only policy");
+    }
+    POLICY.set(policy).map_err(|_| "integration-only policy is already installed")
+}
+
+pub(crate) fn enabled() -> bool {
+    POLICY.get().is_some()
+}
+
+pub fn enabled_for_host() -> bool {
+    enabled()
+}
+
+pub(crate) fn tool_policy() -> Option<ToolPolicy> {
+    POLICY.get().map(|policy| ToolPolicy {
+        allowed_tools: Some(policy.tools.iter().map(ToolName::plain).collect()),
+        require_managed_sandbox: true,
+        require_unified_exec: true,
+        expose_additional_permissions: false,
+    })
+}
