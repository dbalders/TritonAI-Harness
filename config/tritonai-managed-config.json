{
  "schemaVersion": 2,
  "policyVersion": 2,
  "provider": {
    "driver": "codex",
    "managedBinary": true,
    "managedHome": true,
    "baseUrl": "https://tritonai-api.ucsd.edu/v1",
    "sharedApiKeyEnvironmentVariable": "TRITONAI_API_KEY",
    "apiKeySourceEnvironmentVariable": "TRITONAI_API_KEY_SOURCE",
    "routes": {
      "onPrem": {
        "id": "on-prem",
        "instanceId": "codex",
        "displayName": "On-prem models",
        "apiKeyEnvironmentVariable": "TRITONAI_ONPREM_API_KEY"
      },
      "frontier": {
        "id": "frontier",
        "instanceId": "codex_frontier",
        "displayName": "Frontier models",
        "apiKeyEnvironmentVariable": "TRITONAI_FRONTIER_API_KEY"
      }
    }
  },
  "models": {
    "default": "api-glm-5.2",
    "restrictedFallback": "api-glm-5.2",
    "replacements": {
      "gpt-5.5": "gpt-5.6-sol",
      "claude-opus-4-8": "claude-opus-5"
    },
    "catalog": [
      {
        "id": "api-deepseek-v4-flash",
        "name": "DeepSeek v4 Flash",
        "shortName": "DeepSeek",
        "route": "on-prem"
      },
      {
        "id": "api-glm-5.2",
        "name": "GLM 5.2",
        "shortName": "GLM",
        "route": "on-prem"
      },
      {
        "id": "api-gemma-4-31b",
        "name": "Gemma 4 31B",
        "shortName": "Gemma",
        "route": "on-prem"
      },
      {
        "id": "gpt-5.6-luna",
        "name": "GPT-5.6 Luna",
        "route": "frontier"
      },
      {
        "id": "gpt-5.6-sol",
        "name": "GPT-5.6 Sol",
        "route": "frontier"
      },
      {
        "id": "gpt-5.6-terra",
        "name": "GPT-5.6 Terra",
        "route": "frontier"
      },
      {
        "id": "claude-opus-5",
        "name": "Claude Opus 5",
        "route": "frontier"
      }
    ]
  },
  "secureSkills": {
    "pollIntervalMinutes": 360
  }
}
